# Copy to .env.local and fill in. .env.local is git-ignored.
# PostHog project token (public by design, starts with phc_). Find it in PostHog: Settings → Project.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
# Server-side events (posthog-node) go straight to PostHog, not through the proxy.
POSTHOG_HOST=https://us.i.posthog.com
# development | production — attached to every event so test traffic can be filtered out.
NEXT_PUBLIC_APP_ENV=development
